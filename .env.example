# Serona Hotel & Resort — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Application Environment ('development' | 'production')
APP_ENV=development
APP_DEBUG=true
BASE_URL=http://localhost/hotek-serona/
ADMIN_EMAIL=admin@serona.example.com

# Database Connection Settings
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=serona_db
DB_USER=root
DB_PASS=

# Mail Settings
MAIL_FROM_NAME="Serona Hotel & Resort"
MAIL_FROM_ADDRESS=noreply@serona.example.com
MAIL_ADMIN_EMAIL=admin@serona.example.com
MAIL_REPLY_TO=reservations@serona.example.com

# WhatsApp Integration Settings
WHATSAPP_PHONE=94XXXXXXXXX
